{
  "name": "wishy",
  "productName": "Wishy",
  "version": "1.7.0",
  "description": "Widget wishlist avec suivi des prix et dashboard des dépenses",
  "main": "main.js",
  "author": "Jérémy",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "release": "electron-builder --win --publish always"
  },
  "dependencies": {
    "@gradio/client": "^1.19.1",
    "@supabase/supabase-js": "^2.118.0",
    "electron-updater": "^6.8.11",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "docx": "^9.15.1",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.2"
  },
  "build": {
    "appId": "fr.jeremy.wishy",
    "productName": "Wishy",
    "files": [
      "main.js",
      "preload.js",
      "scraper.js",
      "tryon.js",
      "cloud.js",
      "cloud-config.json",
      "sync-core.mjs",
      "src/**/*",
      "assets/**/*",
      "package.json",
      "model3d-core.mjs"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Wishy-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Wishy-portable-${version}.exe"
    },
    "npmRebuild": false,
    "publish": [
      {
        "provider": "github",
        "owner": "jerem57990",
        "repo": "Wishy",
        "releaseType": "release"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jerem57990/Wishy.git"
  }
}
